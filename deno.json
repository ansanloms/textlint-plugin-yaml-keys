{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "version": "0.0.3",
  "exclude": ["dist/", "examples/"],
  "fmt": {
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "plugins": ["jsr:@aireone/deno-lint-curly@0.2.0"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "yaml": "npm:yaml@2.9.0"
  },
  "tasks": {
    "test": "deno test -A --parallel --coverage",
    "check": "deno check **/*.ts",
    "build": "deno bundle --platform=browser ./index.ts -o ./dist/index.js && deno run --allow-read=dist/index.js --allow-write=dist/index.js scripts/strip-cache-paths.ts",
    "lint": "deno lint && deno fmt --check",
    "fix": "deno lint --fix && deno fmt"
  }
}
